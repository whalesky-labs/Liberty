<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Liberty Native Candidate (@TARGET@)" Language="1033"
           Version="@VERSION@" Manufacturer="Liberty" UpgradeCode="@UPGRADE_CODE@">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser" InstallPrivileges="limited" Platform="@PLATFORM@" />
    <MediaTemplate EmbedCab="yes" />
    <MajorUpgrade Schedule="afterInstallInitialize" AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer Liberty Native Candidate is installed. Uninstall it explicitly before selecting an older installer." />
    <Condition Message="This installer requires the matching Windows architecture.">@ARCH_CONDITION@</Condition>
    <Condition Message="Liberty Native Candidate supports only per-user installation.">NOT ALLUSERS</Condition>
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsDirectory" Name="Programs">
          <Directory Id="INSTALLFOLDER" Name="Liberty Native Candidate @TARGET@">
@COMPONENTS@
          </Directory>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="CandidateMenu" Name="Liberty Native Candidate @TARGET@">
          <Component Id="CandidateShortcut" Guid="*" Win64="@WIN64@">
            <Shortcut Id="CandidateLaunch" Name="Liberty Native Candidate @TARGET@" Target="[INSTALLFOLDER]Liberty Native Candidate.exe" WorkingDirectory="INSTALLFOLDER" />
            <RemoveFolder Id="RemoveCandidateMenu" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\Liberty\NativeCandidate\@TARGET@" Name="Shortcut" Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>
    <Feature Id="NativeCandidate" Title="Liberty Native Candidate" Level="1">
@COMPONENT_REFS@
      <ComponentRef Id="CandidateShortcut" />
    </Feature>
    <!-- An opt-in failing transaction exercises the actual MSI rollback path.
         It runs after files are written, before the transaction commits. -->
    <CustomAction Id="AcceptanceRollback" Directory="SystemFolder"
                  ExeCommand="&quot;[SystemFolder]cmd.exe&quot; /d /c exit 1"
                  Execute="deferred" Return="check" Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom Action="AcceptanceRollback" After="InstallFiles">LIBERTY_ACCEPTANCE_FAIL = "1" AND NOT REMOVE</Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
