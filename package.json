{
  "name": "liberty-workspace",
  "private": true,
  "version": "2.0.0-alpha.1",
  "packageManager": "pnpm@10.30.3",
  "type": "module",
  "scripts": {
    "native:migrations:generate": "node scripts/generate-native-migrations.mjs",
    "native:migrations:check": "node scripts/generate-native-migrations.mjs --check",
    "native:export:generate": "node scripts/generate-native-export.mjs",
    "native:export:check": "node scripts/generate-native-export.mjs --check",
    "native:runtime:generate": "node scripts/generate-native-runtime.mjs",
    "native:runtime:check": "node scripts/generate-native-runtime.mjs --check",
    "native:runtime:prepare": "node scripts/prepare-native-runtime.mjs",
    "native:runtime:security": "node scripts/check-native-runtime-security.mjs",
    "native:credentials:acceptance": "node scripts/run-native.mjs credentials-acceptance",
    "native:runtime:acceptance": "node scripts/run-native.mjs runtime-acceptance",
    "native:runtime:candidate:acceptance": "node scripts/run-native.mjs runtime-candidate-acceptance",
    "native:meeting:acceptance": "node scripts/run-native.mjs meeting-acceptance",
    "native:remote:acceptance": "node scripts/run-native.mjs remote-acceptance",
    "native:check": "node scripts/run-native.mjs check",
    "native:bench:reads": "node scripts/run-native.mjs bench-reads",
    "native:licenses": "node scripts/collect-native-licenses.mjs",
    "native:contracts:generate": "node scripts/generate-native-contracts.mjs",
    "native:contracts:check": "node scripts/generate-native-contracts.mjs --check",
    "native:presentation:generate": "node scripts/generate-native-presentation.mjs",
    "native:presentation:check": "node scripts/generate-native-presentation.mjs --check",
    "native:work-art:generate": "node scripts/generate-native-work-art.mjs",
    "native:work-art:check": "node scripts/generate-native-work-art.mjs --check",
    "native:pet-art:generate": "node scripts/generate-native-pet-art.mjs",
    "native:pet-art:check": "node scripts/generate-native-pet-art.mjs --check",
    "native:pet:generate": "node scripts/generate-native-pet.mjs",
    "native:pet:check": "node scripts/generate-native-pet.mjs --check",
    "native:redemption:generate": "node scripts/generate-native-redemption.mjs",
    "native:redemption:check": "node scripts/generate-native-redemption.mjs --check",
    "native:compat": "node scripts/run-native.mjs compat",
    "native:preview": "node scripts/run-native.mjs preview",
    "native:launch": "node scripts/run-native.mjs launch",
    "native:start": "pnpm native:launch",
    "start": "pnpm native:launch",
    "native:build:matrix": "node scripts/run-native.mjs build-matrix",
    "native:package": "node scripts/package-native.mjs",
    "native:distribution:check": "node scripts/package-native-distribution.mjs check && node --test scripts/test-native-distribution.mjs",
    "native:distribution:prepare": "node scripts/package-native-distribution.mjs prepare",
    "native:distribution:build": "node scripts/package-native-distribution.mjs build",
    "native:distribution:verify": "node scripts/package-native-distribution.mjs verify",
    "native:distribution:accept-install": "node scripts/package-native-distribution.mjs accept-install",
    "native:verify": "pnpm native:check && pnpm python:lint && pnpm python:test && pnpm native:release:check",
    "native:release:check": "pnpm native:policy:check && node scripts/check-native-security-baseline.mjs",
    "native:security:check": "node scripts/check-dependency-governance.mjs security --native",
    "native:licenses:check": "node scripts/check-dependency-governance.mjs licenses --native",
    "native:sbom:generate": "node scripts/generate-sbom.mjs --native",
    "check": "pnpm native:verify && pnpm legacy:check:fast:without-python && pnpm desktop:build:web && pnpm rust:clippy && pnpm release:check && pnpm ci:check",
    "check:fast": "pnpm native:check && pnpm legacy:check:fast",
    "legacy:check": "pnpm legacy:check:fast && pnpm desktop:build:web && pnpm rust:clippy && pnpm release:check",
    "legacy:check:fast": "pnpm contracts:check && pnpm desktop:typecheck && pnpm desktop:test && pnpm python:lint && pnpm python:test && pnpm rust:fmt:check && pnpm rust:test",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "contracts:check": "node scripts/check-contracts.mjs",
    "security:check": "node scripts/check-dependency-governance.mjs security",
    "licenses:check": "node scripts/check-dependency-governance.mjs licenses",
    "security:test": "node scripts/test-dependency-governance.mjs && node scripts/test-redeem-key.mjs",
    "sbom:generate": "node scripts/generate-sbom.mjs",
    "asr:fixtures:check": "node scripts/check-asr-fixtures.mjs",
    "asr:benchmark": "node scripts/run-asr-benchmark.mjs",
    "asr:test": "node scripts/test-asr-validation.mjs",
    "platform:smoke": "node scripts/run-platform-smoke.mjs",
    "asr:evidence:check": "node scripts/check-asr-evidence.mjs",
    "desktop:test": "pnpm --dir apps/desktop test",
    "desktop:typecheck": "pnpm --dir apps/desktop typecheck",
    "desktop:check": "pnpm --dir apps/desktop check",
    "desktop:build:web": "pnpm --dir apps/desktop build:web",
    "desktop:build": "pnpm --dir apps/desktop build",
    "python:bootstrap": "node scripts/bootstrap-python-dev.mjs",
    "python:lint": "node scripts/run-python-dev.mjs lint",
    "python:test": "node scripts/run-python-dev.mjs test",
    "redeem-key:keypair": "node scripts/redeem-key.mjs keypair",
    "redeem-key:generate": "node scripts/redeem-key.mjs generate",
    "release:check-platforms": "node scripts/check-platform-matrix.mjs",
    "release:check-security": "node scripts/check-security-baseline.mjs",
    "release:check-runtime-locks": "node scripts/check-runtime-locks.mjs",
    "release:check-versions": "node scripts/check-version-consistency.mjs",
    "release:check": "pnpm release:check-versions && pnpm release:check-platforms && pnpm release:check-security && pnpm release:check-runtime-locks && pnpm security:test && pnpm asr:test",
    "rust:fmt:check": "cargo fmt --all -- --check",
    "rust:test": "cargo test --workspace",
    "rust:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "rust:check": "pnpm release:check && pnpm rust:fmt:check && pnpm rust:test && pnpm rust:clippy",
    "ci:generate": "node scripts/ci/workflows.mjs --write",
    "ci:check": "node scripts/ci/workflows.mjs --check && node --test scripts/ci/test-plan.mjs scripts/ci/test-workflows.mjs scripts/test-version-consistency.mjs",
    "ci:docs": "node scripts/ci/check-docs.mjs",
    "native:policy:check": "node scripts/check-version-consistency.mjs --native && node scripts/check-native-platform-matrix.mjs && node scripts/check-runtime-locks.mjs && node scripts/check-dependency-governance.mjs locks --native && node scripts/check-native-release-policy.mjs && pnpm native:distribution:check && node --test scripts/test-native-release-policy.mjs scripts/test-native-publication.mjs scripts/test-native-platform-matrix.mjs scripts/test-native-security-baseline.mjs && node scripts/test-dependency-governance.mjs && node scripts/test-redeem-key.mjs && node scripts/test-asr-validation.mjs",
    "legacy:check:fast:without-python": "pnpm contracts:check && pnpm desktop:typecheck && pnpm desktop:test && pnpm rust:fmt:check && pnpm rust:test"
  },
  "devDependencies": {
    "@iconify-json/f7": "1.2.2",
    "@iconify/utils": "3.1.3",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "5.9.3"
  }
}
